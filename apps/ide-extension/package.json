{
  "name": "snapkit-debug-sync",
  "displayName": "Snapkit Debug Sync",
  "description": "Debug Dashboard-selected Flutter and React Native devices without modifying project files; fall back to normal IDE debugging offline.",
  "version": "1.6.0",
  "publisher": "snapkit-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug",
    "onStartupFinished"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "snapkit.toggleDashboardTargets",
        "title": "Snapkit: Toggle Dashboard Targets"
      },
      {
        "command": "snapkit.debugReactNative",
        "title": "Snapkit: Debug React Native on Selected Devices"
      },
      {
        "command": "snapkit.reloadReactNative",
        "title": "Snapkit: Reload All React Native Debug Sessions"
      }
    ],
    "configuration": {
      "title": "Snapkit",
      "properties": {
        "snapkit.useDashboardTargets": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Use Dashboard targets for native Run/Debug when the local agent is available and the project matches. Otherwise use the normal IDE configuration."
        },
        "snapkit.agentUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4310",
          "scope": "application",
          "description": "Loopback HTTP address of the local Snapkit agent. Debugging continues normally when this agent is offline."
        },
        "snapkit.syncFlutterRestart": {
          "type": "boolean",
          "default": true,
          "description": "The IDE Restart button also hot restarts other running Flutter debug sessions."
        }
      }
    },
    "debuggers": [
      {
        "type": "snapkit-react-native",
        "label": "Snapkit React Native",
        "languages": [
          "javascript",
          "typescript",
          "javascriptreact",
          "typescriptreact"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "metroPort": {
                "type": "number",
                "default": 8081
              },
              "nodePath": {
                "type": "string",
                "default": "node"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Snapkit: React Native selected devices",
            "type": "snapkit-react-native",
            "request": "launch"
          }
        ]
      }
    ]
  },
  "icon": "icon.png",
  "homepage": "https://snapkit.vn/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bimbimvqt/snapkit.git",
    "directory": "ide-extension"
  },
  "bugs": {
    "url": "https://github.com/bimbimvqt/snapkit/issues"
  },
  "keywords": [
    "flutter",
    "debug",
    "simulator",
    "emulator",
    "snapkit"
  ],
  "galleryBanner": {
    "color": "#101214",
    "theme": "dark"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
