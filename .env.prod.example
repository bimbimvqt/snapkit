APP_ENV=production
POSTGRES_DB=snapkit
POSTGRES_USER=snapkit
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://snapkit:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/snapkit?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@snapkit.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# Use true behind the GitHub/Caddy HTTPS deployment; false only for direct IP-only HTTP.
COOKIE_SECURE=true
# Comma-separated Web OAuth client IDs accepted by the backend. This is required in production.
GOOGLE_OAUTH_CLIENT_IDS=657923282345-dbrjtqdr5aicnhlscjlfmlt31d004oro.apps.googleusercontent.com
# Hard server-side ceiling for one image/video preview upload.
MEDIA_PREVIEW_MAX_MB=1024
# Label shown beside disk usage in Admin. The measurement still comes from this backend host.
STORAGE_SERVER_LABEL=45.119.214.94
# Set true after creating the private R2 bucket and adding all credentials below.
R2_REQUIRED=true
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=snapkit-media-prod
R2_MEDIA_PREFIX=snapkit-media
R2_UPLOAD_URL_TTL_SECONDS=900
R2_READ_URL_TTL_SECONDS=300
R2_FORCE_PATH_STYLE=false
