APP_ENV=production
POSTGRES_DB=toolbox_one
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://toolbox:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/toolbox_one?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# Use true behind the GitHub/Caddy HTTPS deployment; false only for direct IP-only HTTP.
COOKIE_SECURE=true
