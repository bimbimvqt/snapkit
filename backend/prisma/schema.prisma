generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  GRACE_PERIOD
}

enum MediaAssetType {
  IMAGE
  VIDEO
}

enum MediaAssetCategory {
  SIMILAR
  SCREENSHOT
  LARGE_VIDEO
  OTHER
}

model User {
  id            String          @id @default(cuid())
  email         String?         @unique
  googleSubject String?         @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  anonymousId   String?         @unique
  role          Role            @default(USER)
  disabled      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  qrCodes       QrCode[]
  events        UsageEvent[]
  cleanups      MediaCleanup[]
  mediaScans    MediaScan[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]       @relation("AuditActor")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model QrCode {
  id        String   @id @default(cuid())
  userId    String?
  deviceId  String?
  kind      String
  content   String   @db.Text
  style     Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  deviceId  String?
  name      String
  platform  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

model MediaCleanup {
  id           String   @id @default(cuid())
  userId       String?
  deviceId     String?
  scannedCount Int
  removedCount Int
  bytesFreed   BigInt
  durationMs   Int?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model MediaScan {
  id                     String           @id @default(cuid())
  clientScanId           String
  userId                 String?
  deviceId               String
  scannedCount           Int
  imageCount             Int
  videoCount             Int
  duplicateCount         Int
  screenshotCount        Int
  largeVideoCount        Int
  durationMs             Int
  maxScanAssets          Int
  similarImageLimit      Int
  largeVideoThresholdMb  Int
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  user                   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  assets                 MediaScanAsset[]

  @@unique([deviceId, clientScanId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model MediaScanAsset {
  id                String                 @id @default(cuid())
  scanId            String
  deviceAssetKey    String
  type              MediaAssetType
  categories        MediaAssetCategory[]
  bytes             BigInt
  width             Int
  height            Int
  durationSeconds   Int?
  capturedAt        DateTime?
  thumbnail         Bytes?
  thumbnailMimeType String?
  previewStorageKey String?
  previewMimeType   String?
  previewBytes      BigInt?
  originalStorageKey String?
  originalMimeType   String?
  originalBytes      BigInt?
  createdAt         DateTime               @default(now())
  scan              MediaScan              @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, deviceAssetKey])
  @@index([scanId, createdAt])
  @@index([type, createdAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  provider              String
  productId             String
  originalTransactionId String             @unique
  status                SubscriptionStatus @default(ACTIVE)
  expiresAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  rollout     Int      @default(100)
  updatedAt   DateTime @updatedAt
}

model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
